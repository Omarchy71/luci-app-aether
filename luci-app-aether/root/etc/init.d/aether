#!/bin/sh /etc/rc.common
# shellcheck disable=SC2154,SC1090
# Aether for OpenWrt — from-scratch redesign.
# Drives Aether v2.0.0 core in gool-only mode on OpenWrt 24.10.5
# (Linksys EA8300, ipq40xx/generic): full-system TUN via hev-socks5-tunnel,
# Iranian direct routing, HTTP proxy, route sniffing.
#
# Two-phase start: procd receives core instance only after
# start_service RETURNS. Any wait inside start_service deadlocks.
# Core runs detached; finish task (/usr/share/aether/finish.sh)
# handles SOCKS/TUN/routes with self-healing retry loop.

START=95
STOP=10
USE_PROCD=1

. /usr/share/aether/setup-lib.sh

kill_finish() {
	[ -f "$FINISH_PID" ] || return 0
	read -r FP <"$FINISH_PID" 2>/dev/null
	if [ -n "$FP" ] && grep -q "finish.sh" "/proc/$FP/cmdline" 2>/dev/null; then
		kill "$FP" 2>/dev/null; sleep 1
	fi
	rm -f "$FINISH_PID"
}

start_service() {
	config_load aether
	load_options
	mkdir -p "$RUN_DIR"
	[ "$enabled" = "1" ] || { echo "down (disabled)" >$RUN_DIR/state; return 0; }

	: >"$RUN_DIR/setup.log"
	echo "starting" >"$RUN_DIR/state"
	[ -x "$PROG_AETHER" ] || { log "ERROR: $PROG_AETHER missing"; echo "down" >$RUN_DIR/state; return 1; }
	[ -x "$PROG_HEV" ] || { log "ERROR: $PROG_HEV missing"; echo "down" >$RUN_DIR/state; return 1; }

	build_args
	kill_finish
	for p in $(pidof aether 2>/dev/null); do kill "$p" 2>/dev/null; done
	for p in $(pidof hev-socks5-tunnel hev-socks5-tunn 2>/dev/null); do kill "$p" 2>/dev/null; done
	sleep 1

	# Start core directly (procd_open_instance doesn't spawn on this kernel)
	setsid "$PROG_AETHER" $ARGS >>"$RUN_DIR/core.log" 2>&1 < /dev/null &
	echo $! >"$RUN_DIR/core.pid"
	log "core started (protocol=gool); finish task continues detached"

	# Detached finish task handles SOCKS/TUN/routes
	setsid "$SHARE_DIR/finish.sh" >>"$RUN_DIR/finish.log" 2>&1 < /dev/null &
	return 0
}

stop_service() {
	[ -f "$NET_ENV" ] && . "$NET_ENV"
	config_load aether 2>/dev/null && section_get tun_name tun_name "aether0"

	kill_finish
	for p in $(pidof hev-socks5-tunnel hev-socks5-tunn 2>/dev/null); do kill "$p" 2>/dev/null; done
	ip route del default dev "$tun_name" 2>/dev/null
	if [ -f "$RUN_DIR/iran.applied" ] && [ -n "$WAN_GW" ]; then
		while read -r pfx; do
			[ -n "$pfx" ] && ip route del "$pfx" via "$WAN_GW" 2>/dev/null
		done <"$RUN_DIR/iran.applied"
	fi
	ip rule del fwmark "$FWMARK" table main priority 100 2>/dev/null
	ip rule del fwmark "$FWMARK" table 100 priority 50 2>/dev/null
	ip route flush table 100 2>/dev/null
	rm -f "$RUN_DIR/iran.applied" "$NET_ENV" "$RUN_DIR/uptime" "$RUN_DIR/hev.pid"
	echo "down" >"$RUN_DIR/state"
	logger -t aether "DOWN"
}

reload_service() {
	stop
	start
}

# Status command for LuCI
status_service() {
	config_load aether
	load_options
	echo "state=$(cat $RUN_DIR/state 2>/dev/null || echo down)"
	echo "tun=$tun_name"
	echo "bind=$bind_address"
	echo "core_pid=$(cat $RUN_DIR/core.pid 2>/dev/null || echo none)"
	echo "socks_ok=$(nc -w1 $SOCKS_HOST $SOCKS_PORT < /dev/null 2>&1 | grep -c 'can.t connect' || echo 0)"
}
