#!/bin/sh /etc/rc.common
# shellcheck disable=SC2154,SC1090
# Aether for OpenWrt (procd): drive the Aether v2.0.0 core in gool-only
# mode (Linksys EA8300, ipq40xx/generic), layer hev-socks5-tunnel
# as full-system TUN, and route Iranian destinations direct via the WAN.
#
# Flag map mirrors Aethery's profiles.rs as_args() for Protocol::Gool:
# --gool, scan mode, IP version, quick-reconnect, --noize (WG family:
# balanced/aggressive/light/off), --wg-peer, --wiw-outer/inner,
# --keepalive, routing (--routes/--route-direct/--route-block) and
# --mark. NOTE: --peer is deliberately NOT sent for gool (profiles.rs
# only sends it for Auto/MASQUE/WireGuard); MASQUE-only flags
# (--fragment/--ech/--tls-groups) and mim flags are not supported here.
# Loop avoidance: marked core egress leaves via the WAN (fwmark 0x9e
# → table 100), everything else defaults via the TUN once it is up.
START=95
STOP=10
USE_PROCD=1

PROG_AETHER=/usr/sbin/aether
PROG_HEV=/usr/sbin/hev-socks5-tunnel
SHARE_DIR=/usr/share/aether
RUN_DIR=/var/run/aether
ROUTES_OUT=$RUN_DIR/routes.txt
HEV_CONF=$RUN_DIR/hev.yml
NET_ENV=$RUN_DIR/net.env
FWMARK=0x9e
TUN_IPV4=198.18.0.1

IR_DOMAINS="private,digikala.com,aparat.com,filimo.com,telewebion.com,varzesh3.com,snapp.ir,cafebazaar.ir,divar.ir,namava.ir,shad.ir"

log() { logger -t aether "$*"; echo "[$(date +%T)] $*" >>"$RUN_DIR/setup.log"; }

# endpoint looks like host:port (v4/hostname, or [v6]:port)
valid_endpoint() {
	case "$1" in
		*\]:*|*:*) return 0 ;;
		*) return 1 ;;
	esac
}

section_get() { config_get "$2" main "$1" "$3"; }

build_args() {
	ARGS=""
	add() { ARGS="$ARGS $1"; }
	add2() { ARGS="$ARGS $1 $2"; }

	# gool-only: the protocol is fixed, never read from UCI.
	add "--gool"
	case "$scan_mode" in
		turbo) add "--turbo" ;;
		thorough) add "--thorough" ;;
		stealth) add "--stealth" ;;
		ironclad) add "--ironclad" ;;
		*) add "--balanced" ;;
	esac
	case "$ip_version" in
		v4) add "-4" ;;
		v6) add "-6" ;;
		*) add "--dual" ;;
	esac
	if [ "$quick_reconnect" = "1" ]; then add "--quick-reconnect";
	else add "--no-quick-reconnect"; fi
	# WG-family noize only; anything else (e.g. legacy firewall/gfw from a
	# pre-0.2.0 config) falls back to balanced.
	case "$noize" in
		balanced|aggressive|light|off) add2 "--noize" "$noize" ;;
		*) add2 "--noize" "balanced" ;;
	esac

	# Endpoint pinning for gool only (mirrors as_args() for Protocol::Gool).
	# --peer is NOT sent for gool; legacy 'peer'/mim/fragment/ech/tls_groups
	# UCI values are ignored.
	valid_endpoint "$wg_peer" && add2 "--wg-peer" "$wg_peer"
	valid_endpoint "$wiw_outer" && add2 "--wiw-outer" "$wiw_outer"
	valid_endpoint "$wiw_inner" && add2 "--wiw-inner" "$wiw_inner"
	case "$wg_keepalive" in ''|*[!0-9]*) ;;
		*) add2 "--keepalive" "$wg_keepalive" ;;
	esac

	# --bind must reach the core: without it the core listens on its own
	# default while the SOCKS probe checks bind_address (mismatch).
	[ -n "$bind_address" ] && add2 "--bind" "$bind_address"

	# Upstream DNS through the tunnel (mirrors profiles.rs as_args for
	# every protocol incl. gool). Without it the core silently uses its
	# own default instead of the configured value.
	[ -n "$dns" ] && add2 "--dns" "$dns"

	# Routing: custom file wins (preset skipped + logged); otherwise the
	# Iran preset travels in a generated --routes file — ~2850 prefixes
	# can never ride a command line.
	if [ -n "$route_block" ]; then
		add2 "--route-block" "$(echo "$route_block" | tr '\n' ',' | tr -s ',')"
	fi
	if [ -n "$route_direct" ]; then
		USER_DIRECT="$(echo "$route_direct" | tr '\n' ',' | tr -s ',' | sed 's/^,//;s/,$//')"
	else
		USER_DIRECT=""
	fi
	if [ -n "$routes_file" ]; then
		add2 "--routes" "$routes_file"
		[ -n "$USER_DIRECT" ] && add2 "--route-direct" "$USER_DIRECT"
		[ "$direct_iran" = "1" ] && log "custom rules file set — Iran preset skipped"
	elif [ "$direct_iran" = "1" ]; then
		gen_routes_file
		add2 "--routes" "$ROUTES_OUT"
		[ -n "$USER_DIRECT" ] && add2 "--route-direct" "$USER_DIRECT"
	elif [ -n "$USER_DIRECT" ]; then
		add2 "--route-direct" "$USER_DIRECT"
	fi

	add2 "--mark" "$FWMARK"
	echo "$ARGS" >"$RUN_DIR/args"
}

# Same content as Aethery's iran.rs build_routes_content(): user entries
# first, then domains preset, then every embedded prefix.
gen_routes_file() {
	{
		echo "[direct]"
		[ -n "$USER_DIRECT" ] && echo "$USER_DIRECT" | tr ',' '\n'
		echo "$IR_DOMAINS" | tr ',' '\n'
		cat "$SHARE_DIR/iran-v4.txt" "$SHARE_DIR/iran-v6.txt" 2>/dev/null
	} >"$ROUTES_OUT"
	log "routes file: $(wc -l <"$ROUTES_OUT") lines"
}

gen_hev_conf() {
	SOCKS_HOST="${bind_address%:*}"
	SOCKS_PORT="${bind_address##*:}"
	[ -n "$SOCKS_HOST" ] || SOCKS_HOST="127.0.0.1"
	[ -n "$SOCKS_PORT" ] || SOCKS_PORT="1080"
	case "$tun_mtu" in ''|*[!0-9]*) tun_mtu=1420 ;; esac
	[ "$tun_mtu" -lt 1280 ] && tun_mtu=1280
	[ "$tun_mtu" -gt 9000 ] && tun_mtu=9000
	cat >"$HEV_CONF" <<EOF
# Generated by luci-app-aether — do not edit (regenerated per start).
tunnel:
  name: $tun_name
  mtu: $tun_mtu
  multi-queue: false
  ipv4: $TUN_IPV4
socks5:
  address: $SOCKS_HOST
  port: $SOCKS_PORT
  udp: 'udp'
  mark: $FWMARK
misc:
  log-file: '$RUN_DIR/hev.log'
  log-level: warn
  task-stack-size: 86016
EOF
}

wait_for() {
	# $1 = description, $2 = tries, $3 = sh -c test
	i=0
	while ! sh -c "$3" >/dev/null 2>&1; do
		i=$((i + 1))
		if [ "$i" -ge "$2" ]; then
			log "ERROR: $1 not ready"
			return 1
		fi
		sleep 1
	done
	return 0
}

start_service() {
	config_load aether
	for o in enabled scan_mode ip_version noize quick_reconnect \
		wg_peer wiw_outer wiw_inner wg_keepalive bind_address \
		dns vpn_mode tun_name tun_mtu direct_iran route_direct route_block routes_file; do
		section_get "$o" "$o"
	done
	# shellcheck disable=SC2154
	# Defensive defaults — an empty tun_name/bind writes a broken
	# hev.yml and misdirects the SOCKS probe.
	[ -n "$tun_name" ] || tun_name="aether0"
	[ -n "$bind_address" ] || bind_address="127.0.0.1:1080"
	mkdir -p "$RUN_DIR"
	[ "$enabled" = "1" ] || { echo "down (disabled)" >$RUN_DIR/state; return 0; }

	: >"$RUN_DIR/setup.log"
	echo "starting" >"$RUN_DIR/state"
	[ -x "$PROG_AETHER" ] || { log "ERROR: $PROG_AETHER missing"; echo "down" >"$RUN_DIR/state"; return 1; }

	build_args
	# A previous start that timed out waiting for SOCKS leaves the core
	# (and possibly hev) running detached — procd no longer tracks it
	# and a fresh core would collide on --bind. Reap before starting.
	for p in $(pidof aether 2>/dev/null); do kill "$p" 2>/dev/null; done
	for p in $(pidof hev-socks5-tunnel hev-socks5-tunn 2>/dev/null); do kill "$p" 2>/dev/null; done
	sleep 1
	# shellcheck disable=SC2086
	procd_open_instance aether
	procd_set_param command $PROG_AETHER $ARGS
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	# shellcheck disable=SC2154
	log "core started (protocol=gool)"

	SOCKS_HOST="${bind_address%:*}"
	SOCKS_PORT="${bind_address##*:}"
	[ -n "$SOCKS_HOST" ] || SOCKS_HOST="127.0.0.1"
	[ -n "$SOCKS_PORT" ] || SOCKS_PORT="1080"
	# NOTE: this BusyBox nc has no -w1 and exits 0 even on refused
	# connections — but prints "can't connect to remote host". So the
	# probe waits until that message DISAPPEARS (SOCKS up).
	# 1200 tries: a full gool scan + validation took 10+ minutes on this
	# link — timing out earlier orphans the core (still running, never
	# reaching hev/TUN setup) and wedges the service in state=down.
	wait_for "SOCKS $bind_address" 1200 "! (nc $SOCKS_HOST $SOCKS_PORT < /dev/null 2>&1 | grep -q \"can.t connect\")" \
		|| { echo "down" >"$RUN_DIR/state"; return 1; }

	if [ "$vpn_mode" = "1" ]; then
		[ -x "$PROG_HEV" ] || { log "ERROR: $PROG_HEV missing (opkg install hev-socks5-tunnel)"; echo "down" >"$RUN_DIR/state"; return 1; }
		gen_hev_conf
		procd_open_instance hev
		procd_set_param command $PROG_HEV "$HEV_CONF"
		procd_set_param respawn 3600 5 5
		procd_close_instance
		wait_for "TUN $tun_name" 15 "ip link show $tun_name" \
			|| { echo "down" >"$RUN_DIR/state"; return 1; }
		net_up || { echo "down" >"$RUN_DIR/state"; return 1; }
	fi

	date -u +%FT%TZ >"$RUN_DIR/uptime"
	echo "up" >"$RUN_DIR/state"
	log "UP (tun=$([ "$vpn_mode" = "1" ] && echo "$tun_name" || echo "proxy-only"))"
}

net_up() {
	# Original WAN path first — everything direct hangs off it.
	WAN_GW="$(ip route show default | grep -v "dev $tun_name" | head -1 | sed -n 's/.*via \([0-9.]*\).*/\1/p')"
	WAN_DEV="$(ip route show default | grep -v "dev $tun_name" | head -1 | sed -n 's/.*dev \([^ ]*\).*/\1/p')"
	[ -n "$WAN_GW" ] || { log "ERROR: no WAN gateway found"; return 1; }
	echo "WAN_GW=$WAN_GW" >"$NET_ENV"
	echo "WAN_DEV=$WAN_DEV" >>"$NET_ENV"

	ip rule show | grep -q "fwmark $FWMARK" \
		|| ip rule add fwmark "$FWMARK" table main priority 100

	# Marked core egress must leave via WAN even after the TUN becomes
	# the default route — otherwise it loops back into the tunnel.
	ip route replace default via "$WAN_GW" dev "$WAN_DEV" table 100
	ip rule show | grep -q "fwmark $FWMARK.*table 100" \
		|| ip rule add fwmark "$FWMARK" table 100 priority 50

	# Iran prefixes direct via WAN, v4 + v6 (same set the core gets in
	# the --routes file); the applied set is recorded so stop removes
	# exactly what start added. v6 adds fail silently on v4-only WAN.
	: >"$RUN_DIR/iran.applied"
	if [ "$direct_iran" = "1" ] && [ -z "$routes_file" ]; then
		for f in "$SHARE_DIR/iran-v4.txt" "$SHARE_DIR/iran-v6.txt"; do
			while read -r pfx; do
				case "$pfx" in ''|\#*) continue ;; esac
				if ip route add "$pfx" via "$WAN_GW" dev "$WAN_DEV" 2>/dev/null; then
					echo "$pfx" >>"$RUN_DIR/iran.applied"
				fi
			done <"$f"
		done
		log "iran direct routes: $(wc -l <"$RUN_DIR/iran.applied") via $WAN_GW"
	fi

	# The TUN default (metric 5) only wins if the WAN default has a higher
	# metric — DHCP/static WAN routes often sit at metric 0 and would
	# otherwise keep all traffic off the tunnel.
	WAN_METRIC="$(ip route show default | grep -v "dev $tun_name" | head -1 | sed -n 's/.*metric \([0-9]*\).*/\1/p')"
	[ -n "$WAN_METRIC" ] || WAN_METRIC=0
	if [ "$WAN_METRIC" -lt 5 ]; then
		while ip route show default | grep -qF "via $WAN_GW dev $WAN_DEV"; do
			ip route del default via "$WAN_GW" dev "$WAN_DEV" 2>/dev/null || break
		done
		ip route add default via "$WAN_GW" dev "$WAN_DEV" metric 10
		log "WAN default metric $WAN_METRIC -> 10 so TUN wins (fallback kept)"
	fi

	if ! ip route show default | grep -q "dev $tun_name"; then
		ip route add default dev "$tun_name" metric 5 \
			|| ip route replace default dev "$tun_name" metric 5
	fi
	log "default via $tun_name (metric 5); WAN kept as fallback"
}

stop_service() {
	[ -f "$NET_ENV" ] && . "$NET_ENV"
	config_load aether 2>/dev/null && section_get tun_name tun_name "aether0"
	ip route del default dev "$tun_name" 2>/dev/null
	if [ -f "$RUN_DIR/iran.applied" ] && [ -n "$WAN_GW" ]; then
		while read -r pfx; do
			[ -n "$pfx" ] && ip route del "$pfx" via "$WAN_GW" 2>/dev/null
		done <"$RUN_DIR/iran.applied"
	fi
	ip rule del fwmark "$FWMARK" table main priority 100 2>/dev/null
	ip rule del fwmark "$FWMARK" table 100 priority 50 2>/dev/null
	ip route flush table 100 2>/dev/null
	rm -f "$RUN_DIR/iran.applied" "$NET_ENV" "$RUN_DIR/uptime"
	echo "down" >"$RUN_DIR/state"
	logger -t aether "DOWN"
}

reload_service() {
	stop
	start
}
