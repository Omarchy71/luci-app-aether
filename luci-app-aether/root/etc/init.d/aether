#!/bin/sh /etc/rc.common
# Aether Core init script with auto-connect, auto-reconnect, YouTube monitoring
# Supports: OpenWrt 24.10.5, Linksys EA8300 (ipq40xx/generic)

START=95
STOP=15
USE_PROCD=1

SERVICE_NAME=aether
AETHER_DIR=/usr/share/aether
AETHER_BIN=/usr/sbin/aether
HEV_BIN=/usr/bin/hev-socks5-tunnel

. $AETHER_DIR/setup-lib.sh

# ─── helpers ──────────────────────────────────
is_wan_up() {
	ip route show default 2>/dev/null | grep -q "default" && return 0
	return 1
}

wait_for_wan() {
	local wait_time="$(config_get main wan_wait '30')"
	[ -z "$wait_time" ] && wait_time=30
	local i=0
	while [ $i -lt "$wait_time" ]; do
		if is_wan_up; then
			return 0
		fi
		sleep 1
		i=$((i+1))
	done
	echo "[aether] WAN not fully up after ${wait_time}s, proceeding"
	return 0
}

aether_running() {
	pgrep -f "$AETHER_BIN" >/dev/null 2>&1
}

# ─── start service ────────────────────────────
start_service() {
	config_load aether
	load_options

	[ "$enabled" = "1" ] || return 1

	echo "[aether] Starting..."
	wait_for_wan
	build_args

	# Kill any stale instances
	stop_service 2>/dev/null

	# Start hev socks5 if vpn_mode=1
	if [ "$vpn_mode" = "1" ]; then
		mkdir -p /var/run/aether /var/run/hev
		$HEV_BIN -b "$bind_address" -s &
		sleep 1
	fi

	# Start aether core
	mkdir -p /var/run/aether
	$AETHER_BIN $ARGS &
	echo "$ARGS" > /var/run/aether/args 2>/dev/null
	echo "started" > /var/run/aether/core_state 2>/dev/null

	# Start finish task (self-healing TUN)
	setsid /usr/share/aether/finish.sh >/dev/null 2>&1 &

	# Start watchdog if auto_reconnect enabled
	if [ "$auto_reconnect" = "1" ]; then
		setsid /usr/share/aether/egress-check.sh --watchdog >/dev/null 2>&1 &
	fi

	# Start YouTube monitoring if enabled
	if [ "$youtube_check" = "1" ]; then
		setsid /usr/share/aether/egress-check.sh --youtube >/dev/null 2>&1 &
	fi

	# Start initial YouTube check
	if [ "$youtube_check" = "1" ]; then
		/usr/share/aether/egress-check.sh --check-once >/dev/null 2>&1 &
	fi

	echo "[aether] Started (PID: $(pgrep -f $AETHER_BIN))"
	echo "[aether] Auto-connect: $auto_connect, Auto-reconnect: $auto_reconnect, YouTube check: $youtube_check"
}

# ─── stop service ─────────────────────────────
stop_service() {
	echo "[aether] Stopping..."
	pkill -TERM -f "$AETHER_BIN" 2>/dev/null
	pkill -KILL -f "$AETHER_BIN" 2>/dev/null
	pkill -TERM -f "$HEV_BIN" 2>/dev/null
	pkill -KILL -f "$HEV_BIN" 2>/dev/null
	ip route del table 100 2>/dev/null
	ip route del table 200 2>/dev/null
	ip link set "$tun_name" down 2>/dev/null
	echo "stopped" > /var/run/aether/core_state 2>/dev/null
	echo "[aether] Stopped"
}

# ─── restart with reconnect logic ─────────────
restart_with_reconnect() {
	config_load aether
	load_options
	echo "[aether] Restarting..."
	stop_service
	sleep "$reconnect_interval"
	start_service
}

# ─── reload ───────────────────────────────────
reload() {
	config_load aether
	load_options
	if [ "$enabled" = "1" ]; then
		if [ "$auto_reconnect" = "1" ]; then
			restart_with_reconnect &
		else
			stop_service
			start_service
		fi
	fi
}

# ─── triggers ─────────────────────────────────
service_triggers() {
	procd_add_reload_trigger "aether"
	procd_add_network_trigger "interface.wan"
}

echo "[aether] Init script loaded"
