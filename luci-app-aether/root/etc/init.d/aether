#!/bin/sh /etc/rc.common
# Aether Core init script — Proxy/VPN mode toggle + OPT-1..7
# Supports: OpenWrt 24.10.5, Linksys EA8300 (ipq40xx/generic)

START=95
STOP=15
USE_PROCD=1

SERVICE_NAME=aether
AETHER_DIR=/usr/share/aether
AETHER_BIN=/usr/sbin/aether
HEV_BIN=/usr/bin/hev-socks5-tunnel
PROXY_SCRIPT=/usr/share/aether/proxy-server.sh

. $AETHER_DIR/setup-lib.sh

# ─── helpers ──────────────────────────────
is_wan_up() {
	ip route show default 2>/dev/null | grep -q "default" && return 0
	return 1
}

wait_for_wan() {
	local wait_time="$(config_get main wan_wait '30')"
	[ -z "$wait_time" ] && wait_time=30
	local i=0
	while [ $i -lt "$wait_time" ]; do
		if is_wan_up; then return 0; fi
		sleep 1; i=$((i+1))
	done
	echo "[aether] WAN not fully up after ${wait_time}s, proceeding"
	return 0
}

aether_running() {
	pgrep -f "$AETHER_BIN" >/dev/null 2>&1
}

# ─── Mode helpers ─────────────────────────
get_mode() {
	config_get mode main mode 'vpn'
	echo "$mode"
}

get_proxy_enabled() {
	config_get proxy_enabled proxy settings '0'
	echo "$proxy_enabled"
}

# ─── Start proxy mode ─────────────────────
start_proxy_mode() {
	echo "[aether] Starting PROXY mode..."
	mkdir -p /var/run/aether /var/run/aether/proxy
	procd_open_instance proxy
	procd_set_param command "$PROXY_SCRIPT" start
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits mem="5m"
	procd_set_param nice 10
	procd_close_instance
	sleep 2
	$PROXY_SCRIPT info > /var/run/aether/proxy_info.json 2>/dev/null
	cat > /var/run/aether/status.json << 'STATUSJSON'
{"mode":"proxy","status":"active","tunnel":"none"}
STATUSJSON
	echo "[aether] Proxy mode active"
}

stop_proxy_mode() {
	$PROXY_SCRIPT stop 2>/dev/null
	procd_close_instance proxy 2>/dev/null
}

# ─── Start VPN mode ───────────────────────
start_vpn_mode() {
	config_load aether
	load_options
	[ "$enabled" = "1" ] || return 1

	echo "[aether] Starting VPN mode..."
	wait_for_wan
	build_args

	# Kill stale instances
	stop_service 2>/dev/null

	# tmpfs overlay (OPT-4)
	mkdir -p /var/run/aether
	mount -t tmpfs -o size=10m tmpfs /var/run/aether 2>/dev/null || true

	# hev socks5 (OPT-1)
	if [ "$vpn_mode" = "1" ]; then
		mkdir -p /var/run/hev
		procd_open_instance hev
		procd_set_param command "$HEV_BIN" -b "$bind_address" -s
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param limits mem="10m"
		procd_set_param nice 0
		procd_close_instance
		sleep 1
	fi

	# aether core (OPT-1: 80MB RAM, 50% CPU, nice -5)
	procd_open_instance aether
	procd_set_param command "$AETHER_BIN" $ARGS
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits mem="80m" cpu="500000"
	procd_set_param nice -5
	procd_close_instance

	echo "$ARGS" > /var/run/aether/args 2>/dev/null

	# finish task (OPT-1)
	procd_open_instance finish
	procd_set_param command /usr/share/aether/finish.sh
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param limits mem="20m"
	procd_set_param nice 5
	procd_close_instance

	# watchdog (OPT-1)
	if [ "$auto_reconnect" = "1" ]; then
		procd_open_instance watchdog
		procd_set_param command /usr/share/aether/egress-check.sh
		procd_set_param command_args "--watchdog"
		procd_set_param respawn
		procd_set_param limits mem="15m"
		procd_set_param nice 10
		procd_close_instance
	fi

	# YouTube monitor (OPT-1)
	if [ "$youtube_check" = "1" ]; then
		procd_open_instance youtube
		procd_set_param command /usr/share/aether/egress-check.sh
		procd_set_param command_args "--youtube"
		procd_set_param respawn
		procd_set_param limits mem="15m"
		procd_set_param nice 10
		procd_close_instance
	fi

	cat > /var/run/aether/status.json << STATUSJSON
{"mode":"vpn","status":"active","tunnel":"$tun_name"}
STATUSJSON

	echo "[aether] VPN mode active (PID: $(pgrep -f $AETHER_BIN))"
	echo "[aether] Limits: 80m RAM, 50% CPU, nice=-5"
}

# ─── start service ────────────────────────
start_service() {
	config_load aether
	load_options
	local mode="$(get_mode)"
	local proxy_en="$(get_proxy_enabled)"

	[ "$enabled" = "1" ] || return 1

	echo "[aether] Starting with mode: $mode, proxy_enabled: $proxy_en"

	if [ "$mode" = "proxy" ] && [ "$proxy_en" = "1" ]; then
		start_proxy_mode
		return 0
	fi

	start_vpn_mode
}

# ─── stop service ─────────────────────────
stop_service() {
	echo "[aether] Stopping..."
	procd_close_instance aether 2>/dev/null
	procd_close_instance hev 2>/dev/null
	procd_close_instance finish 2>/dev/null
	procd_close_instance watchdog 2>/dev/null
	procd_close_instance youtube 2>/dev/null
	procd_close_instance proxy 2>/dev/null
	pkill -TERM -f "$AETHER_BIN" 2>/dev/null
	pkill -KILL -f "$AETHER_BIN" 2>/dev/null
	pkill -TERM -f "$HEV_BIN" 2>/dev/null
	pkill -KILL -f "$HEV_BIN" 2>/dev/null
	pkill -TERM -f "microsocks" 2>/dev/null
	pkill -KILL -f "microsocks" 2>/dev/null
	pkill -TERM -f "tinyproxy" 2>/dev/null
	pkill -KILL -f "tinyproxy" 2>/dev/null
	ip route del table 100 2>/dev/null
	ip route del table 200 2>/dev/null
	ip link set "$tun_name" down 2>/dev/null
	echo "stopped" > /var/run/aether/core_state 2>/dev/null
	echo "[aether] Stopped"
}

# ─── restart ──────────────────────────────
restart_with_reconnect() {
	config_load aether
	load_options
	local mode="$(get_mode)"
	echo "[aether] Restarting..."
	stop_service
	sleep "$reconnect_interval"
	start_service
}

# ─── reload ───────────────────────────────
reload() {
	config_load aether
	load_options
	local mode="$(get_mode)"
	local proxy_en="$(get_proxy_enabled)"
	if [ "$enabled" = "1" ]; then
		if [ "$mode" = "proxy" ] && [ "$proxy_en" = "1" ]; then
			stop_proxy_mode
			start_proxy_mode
		else
			restart_with_reconnect
		fi
	fi
}

# ─── triggers ─────────────────────────────
service_triggers() {
	procd_add_reload_trigger "aether"
	procd_add_network_trigger "interface.wan"
}

echo "[aether] Init script loaded (proxy/vpn toggle)"
