#!/bin/sh /etc/rc.common
# shellcheck disable=SC2154,SC1090
# Aether for OpenWrt (procd): drive the Aether v2.0.0 core in gool-only
# mode (Linksys EA8300, ipq40xx/generic), layer hev-socks5-tunnel
# as full-system TUN, and route Iranian destinations direct via the WAN.
#
# Two-phase start (do NOT collapse back into one): procd only receives
# the core instance once start_service RETURNS (rc.common sends it in
# procd_close_service). Any wait longer than a second inside
# start_service therefore deadlocks the service — the core would never
# spawn, and the wait could never succeed. So start_service only
# registers the core and returns; the detached finish task
# (/usr/share/aether/finish.sh) waits for the core's SOCKS port, then
# layers hev/TUN + routes on top. Shared logic lives in setup-lib.sh.
#
# Flag map mirrors Aethery's profiles.rs as_args() for Protocol::Gool:
# --gool, scan mode, IP version, quick-reconnect, --noize (WG family:
# balanced/aggressive/light/off), --wg-peer, --wiw-outer/inner,
# --keepalive, routing (--routes/--route-direct/--route-block) and
# --mark. NOTE: --peer is deliberately NOT sent for gool (profiles.rs
# only sends it for Auto/MASQUE/WireGuard); MASQUE-only flags
# (--fragment/--ech/--tls-groups) and mim flags are not supported here.
# Loop avoidance: marked core egress leaves via the WAN (fwmark 0x9e
# → table 100), everything else defaults via the TUN once it is up.
START=95
STOP=10
USE_PROCD=1

# Shared setup logic (also used by the detached finish task); rc.common
# already sourced /lib/functions.sh + procd.sh for this script.
. /usr/share/aether/setup-lib.sh

# Kill a stale finish task (verified by cmdline, never by bare PID).
kill_finish() {
	[ -f "$FINISH_PID" ] || return 0
	read -r FP <"$FINISH_PID" 2>/dev/null
	if [ -n "$FP" ] && grep -q "finish.sh" "/proc/$FP/cmdline" 2>/dev/null; then
		kill "$FP" 2>/dev/null; sleep 1
	fi
	rm -f "$FINISH_PID"
}

start_service() {
	config_load aether
	load_options
	mkdir -p "$RUN_DIR"
	[ "$enabled" = "1" ] || { echo "down (disabled)" >$RUN_DIR/state; return 0; }

	: >"$RUN_DIR/setup.log"
	echo "starting" >"$RUN_DIR/state"
	[ -x "$PROG_AETHER" ] || { log "ERROR: $PROG_AETHER missing"; echo "down" >$RUN_DIR/state; return 1; }

	build_args
	# A stale finish task would race the new one on SOCKS/TUN — stop it.
	kill_finish
	# Detached leftovers of a previous wedged start collide on --bind.
	for p in $(pidof aether 2>/dev/null); do kill "$p" 2>/dev/null; done
	for p in $(pidof hev-socks5-tunnel hev-socks5-tunn 2>/dev/null); do kill "$p" 2>/dev/null; done
	sleep 1
	# shellcheck disable=SC2086
	procd_open_instance aether
	procd_set_param command $PROG_AETHER $ARGS
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	log "core registered (protocol=gool); TUN finish continues detached"
	# Must return immediately (see header): the finish task survives this
	# shell (setsid) and completes the setup once the core is up.
	setsid "$SHARE_DIR/finish.sh" >>"$RUN_DIR/finish.log" 2>&1 < /dev/null &
	return 0
}

stop_service() {
	[ -f "$NET_ENV" ] && . "$NET_ENV"
	config_load aether 2>/dev/null && section_get tun_name tun_name "aether0"
	# Stop a pending finish task first so it can't resurrect hev/TUN.
	kill_finish
	# Backup for a detached hev (procd kills tracked instances itself).
	for p in $(pidof hev-socks5-tunnel hev-socks5-tunn 2>/dev/null); do kill "$p" 2>/dev/null; done
	ip route del default dev "$tun_name" 2>/dev/null
	if [ -f "$RUN_DIR/iran.applied" ] && [ -n "$WAN_GW" ]; then
		while read -r pfx; do
			[ -n "$pfx" ] && ip route del "$pfx" via "$WAN_GW" 2>/dev/null
		done <"$RUN_DIR/iran.applied"
	fi
	ip rule del fwmark "$FWMARK" table main priority 100 2>/dev/null
	ip rule del fwmark "$FWMARK" table 100 priority 50 2>/dev/null
	ip route flush table 100 2>/dev/null
	rm -f "$RUN_DIR/iran.applied" "$NET_ENV" "$RUN_DIR/uptime" "$RUN_DIR/hev.pid"
	echo "down" >"$RUN_DIR/state"
	logger -t aether "DOWN"
}

reload_service() {
	stop
	start
}
