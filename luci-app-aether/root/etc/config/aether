config aether 'main'
	option enabled '0'
	option protocol 'gool'
	option scan_mode 'balanced'
	option ip_version 'both'
	option noize 'balanced'
	option quick_reconnect '1'
	option wg_keepalive '25'
	option wg_stale_secs '10'
	option wg_endpoint_cooldown '300'
	option wiw_scan '1'
	option wg_peer ''
	option wiw_outer ''
	option wiw_inner ''
	option bind_address '127.0.0.1:1080'
	option dns '1.1.1.1'
	option vpn_mode '1'
	option tun_name 'aether0'
	option tun_mtu '1420'
	option direct_iran '1'
	option route_direct ''
	option route_block ''
	option routes_file ''
	option http_proxy '0'
	option http_port '1820'
	option upstream_proxy ''
	option tls_groups ''
	option masque_h2 '0'
	option masque_quic_v2 '1'
	option masque_ech 'auto'
	option masque_fragment '0'
	option masque_fragment_size ''
	option masque_fragment_delay ''
	option masque_h2_peer ''
	option masque_no_data_check '0'
	option startup_secs '30'
	option masque_h2_keepalive_secs '15'
	option mim_outer ''
	option mim_inner ''
	option tor '0'
	option tor_bind ''
	option tor_dir ''
	option tor_bridges ''
	option tor_pt ''
	option route_sniff '1'
	option sniffing_timeout_ms '400'
	option no_profile_retry '0'
	option reprovision '1'
	option perf_profile 'low'
	option log_level 'info'
	option verbose '0'
	option netstack_tcp_rx ''
	option netstack_tcp_tx ''
	option max_clients '512'
	option team ''
	option access_id ''
	option access_secret ''
	option access_token ''
	option access_email ''
	option gateway '0'
	# New options
	option auto_connect '1'
	option auto_reconnect '1'
	option reconnect_interval '10'
	option max_reconnect_attempts '0'
	option youtube_check '1'
	option youtube_check_interval '60'
	option check_url 'https://www.youtube.com'
	option check_timeout '15'
	option watchdog_interval '30'
	option wan_wait '30'

# ─── Mode: proxy or vpn ────────────────────
config 'mode' 'main'
    option 'mode' 'vpn'
    option 'http_port' '8080'
    option 'socks_port' '1080'
    option 'proxy_interface' '0.0.0.0'

# ─── Proxy mode settings ───────────────────
config 'proxy' 'settings'
    option 'proxy_enabled' '0'
    option 'http_port' '8080'
    option 'socks_port' '1080'
    option 'proxy_bind' '0.0.0.0'
