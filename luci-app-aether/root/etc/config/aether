config aether 'main'
	option enabled '0'
	# Fixed protocol: gool (WG-in-WG). Kept only for display/compat; the
	# init script always passes --gool regardless of this value.
	option protocol 'gool'
	option scan_mode 'balanced'
	option ip_version 'both'
	option noize 'balanced'
	option quick_reconnect '1'
	option wg_peer ''
	option wiw_outer ''
	option wiw_inner ''
	option wg_keepalive '25'
	option bind_address '127.0.0.1:1080'
	option dns '1.1.1.1'
	option vpn_mode '1'
	option tun_name 'aether0'
	option tun_mtu '1420'
	option direct_iran '1'
	option route_direct ''
	option route_block ''
	option routes_file ''
