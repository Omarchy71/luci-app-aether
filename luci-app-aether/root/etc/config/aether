config aether 'main'
	option enabled '0'
	# Fixed protocol: gool (WG-in-WG). Kept for display/compat only.
	option protocol 'gool'
	# Scan mode: turbo | balanced | thorough | stealth | ironclad
	option scan_mode 'balanced'
	# IP version: v4 | v6 | both
	option ip_version 'both'
	# Obfuscation profile: none | light | firewall | balanced | gfw | aggressive
	option noize 'balanced'
	# Quick reconnect (0 or 1)
	option quick_reconnect '1'
	# Endpoint pinning (host:port — empty = auto-scan)
	option wg_peer ''
	option wiw_outer ''
	option wiw_inner ''
	# WireGuard keepalive (seconds)
	option wg_keepalive '25'
	# SOCKS5 bind address
	option bind_address '127.0.0.1:1080'
	# Upstream DNS (comma-separated)
	option dns '1.1.1.1'
	# Full-system VPN mode (0 = SOCKS proxy only, 1 = full TUN)
	option vpn_mode '1'
	# TUN interface name
	option tun_name 'aether0'
	# TUN MTU
	option tun_mtu '1420'
	# Direct routing for Iranian sites
	option direct_iran '1'
	# Custom direct routes (comma/newline)
	option route_direct ''
	# Blocked routes (comma/newline)
	option route_block ''
	# Custom rules file path
	option routes_file ''
	# HTTP proxy (0 = off, 1 = on at port below)
	option http_proxy '0'
	# HTTP proxy port
	option http_port '1820'
	# TLS key share groups
	option tls_groups ''
	# Data-plane validation seconds
	option validate_secs '10'
	# Reconnect delay seconds
	option reconnect_secs '2'
	# Skip profile retry during scan
	option no_profile_retry '0'
	# Route sniffing (0 = off, 1 = on)
	option route_sniff '1'
	# Route sniffing timeout ms
	option sniffing_timeout_ms '400'
	# Reprovision identity
	option reprovision '1'
	# WG endpoint cooldown seconds
	option wg_endpoint_cooldown '300'
	# Performance profile: low | medium | high
	option perf_profile 'low'
	# Netstack TCP RX buffer
	option netstack_tcp_rx ''
	# Netstack TCP TX buffer
	option netstack_tcp_tx ''
